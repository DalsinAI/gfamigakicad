+}
+
+
+#ifdef KICAD_AMIGA
+static size_t amigaTarOctal( const char* aField, int aLen )
+{
+    size_t value = 0;
+
+    for( int i = 0; i < aLen && aField[i]; i++ )
+    {
+        if( aField[i] >= '0' && aField[i] <= '7' )
+            value = value * 8 + ( aField[i] - '0' );
+        else if( aField[i] != ' ' )
+            break;
+    }
+
+    return value;
+}
+
+
+bool ASSET_ARCHIVE::loadAmigaTar( wxInputStream& aStream, wxFileOffset aPackedLength )
+{
+    m_cache.resize( 2 * aPackedLength );
+
+    size_t      offset = 0;
+    std::string longName;
+    char        hdr[512];
+
+    auto readFully = [&]( void* aDest, size_t aLen ) -> bool
+    {
+        aStream.Read( aDest, aLen );
+        return aStream.LastRead() == aLen;
+    };
+
+    auto skip = [&]( size_t aLen ) -> bool
+    {
+        char buf[512];
+
+        while( aLen > 0 )
+        {
+            size_t n = std::min( aLen, sizeof( buf ) );
+
+            if( !readFully( buf, n ) )
+                return false;
+
+            aLen -= n;
+        }
+
+        return true;
+    };
+
+    while( readFully( hdr, sizeof( hdr ) ) )
+    {
+        if( hdr[0] == 0 )
+            break;  // the all-zero end blocks
+
+        size_t length = amigaTarOctal( hdr + 124, 12 );
+        size_t padded = ( length + 511 ) & ~(size_t) 511;
+        char   type = hdr[156];
+
+        if( type == 'L' )  // GNU long name: the next entry's name is the data
+        {
+            longName.assign( length, 0 );
+
+            if( !readFully( &longName[0], length ) || !skip( padded - length ) )
+                return false;
+
+            longName.resize( strnlen( longName.c_str(), length ) );
+            continue;
+        }
+
+        if( type != '0' && type != 0 )  // directories, links, pax records
+        {
+            if( !skip( padded ) )
+                return false;
+
+            longName.clear();
+            continue;
+        }
+
+        std::string name;
+
+        if( !longName.empty() )
+        {
+            name = longName;
+        }
+        else
+        {
+            std::string prefix( hdr + 345, strnlen( hdr + 345, 155 ) );
+            name.assign( hdr, strnlen( hdr, 100 ) );
+
+            if( memcmp( hdr + 257, "ustar\0", 6 ) == 0 && !prefix.empty() )
+                name = prefix + "/" + name;
+        }
+
+        longName.clear();
+
+        while( name.compare( 0, 2, "./" ) == 0 )
+            name.erase( 0, 2 );
+
+        if( offset + length > m_cache.size() )
+            m_cache.resize( std::max( m_cache.size() * 2, offset + length ) );
+
+        if( !readFully( &m_cache[offset], length ) || !skip( padded - length ) )
+            return false;
+
+        FILE_INFO fi;
+        fi.offset = offset;
+        fi.length = length;
+        m_fileInfoCache[wxString::FromUTF8( name.c_str() )] = fi;
+
+        offset += length;
+    }
+
+    m_cache.resize( offset );
+
     return true;
 }
+#endif
 
 
