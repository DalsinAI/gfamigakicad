diff --git a/libs/kiplatform/os/common/io.cpp b/libs/kiplatform/os/common/io.cpp
index 68928f4e..1c34d3db 100644
--- a/libs/kiplatform/os/common/io.cpp
+++ b/libs/kiplatform/os/common/io.cpp
@@ -121,6 +121,40 @@ FILE* KIPLATFORM::IO::OpenUniqueSiblingTempFile( const wxString& aTargetPath, co
 }
 
 
+#if defined( __amigaos__ )
+// AmigaOS: soft links are rare and libnix has no lstat()/realpath(); a
+// folder needs no flush (AmigaDOS writes it with the file); and rename()
+// will not replace a file, so the old one is deleted first (not atomic:
+// CommitTempFile's temporary copy is the fallback if the program stops
+// between the two).
+wxString KIPLATFORM::IO::ResolveSymlinkTarget( const wxString& aPath )
+{
+    return aPath;
+}
+
+
+bool KIPLATFORM::IO::FlushDirectory( const wxString& )
+{
+    return true;
+}
+
+
+bool KIPLATFORM::IO::AtomicRename( const wxString& aSrc, const wxString& aDst, wxString* aError )
+{
+    if( rename( aSrc.fn_str(), aDst.fn_str() ) == 0 )
+        return true;
+
+    if( wxFileName::FileExists( aDst ) && remove( aDst.fn_str() ) == 0
+            && rename( aSrc.fn_str(), aDst.fn_str() ) == 0 )
+        return true;
+
+    if( aError )
+        *aError = wxString::FromUTF8( strerror( errno ) );
+
+    return false;
+}
+
+#else
 wxString KIPLATFORM::IO::ResolveSymlinkTarget( const wxString& aPath )
 {
     // Users commonly symlink shared config/project files into their working directory.
@@ -174,6 +208,8 @@ bool KIPLATFORM::IO::AtomicRename( const wxString& aSrc, const wxString& aDst, w
     return false;
 }
 
+#endif // __amigaos__
+
 #endif // !_WIN32
 
 
