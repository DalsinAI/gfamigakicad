+bool KIPLATFORM::IO::FlushDirectory( const wxString& )
+{
+    return true;
+}
+
+
+bool KIPLATFORM::IO::AtomicRename( const wxString& aSrc, const wxString& aDst, wxString* aError )
+{
+    if( rename( aSrc.fn_str(), aDst.fn_str() ) == 0 )
+        return true;
+
+    if( wxFileName::FileExists( aDst ) && remove( aDst.fn_str() ) == 0
+            && rename( aSrc.fn_str(), aDst.fn_str() ) == 0 )
+        return true;
+
+    if( aError )
+        *aError = wxString::FromUTF8( strerror( errno ) );
+
+    return false;
+}
+
