# CMake toolchain for GFOpenAmigaGCC (m68k-amigaos, 68040, soft float).
# STOVE_PREFIX: the compiler's prefix folder; DEPS_PREFIX: our built dependencies.
# Copyright (c) 2026 AmiCradle Team.
set(CMAKE_SYSTEM_NAME AmigaOS)
set(CMAKE_SYSTEM_PROCESSOR m68k)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
set(TC "$ENV{STOVE_PREFIX}")
set(CMAKE_C_COMPILER   "${TC}/bin/m68k-amigaos-gcc")
set(CMAKE_CXX_COMPILER "${TC}/bin/m68k-amigaos-g++")
set(CMAKE_AR     "${TC}/bin/m68k-amigaos-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "${TC}/bin/m68k-amigaos-ranlib" CACHE FILEPATH "")
set(KC_SPECS "$ENV{KC_SPECS}")
set(KC_FLAGS "-noixemul -m68040 -fno-delete-null-pointer-checks")
set(KC_CFLAGS "-include ${CMAKE_CURRENT_LIST_DIR}/../compat/include/gfamiga_prefix.h -I${CMAKE_CURRENT_LIST_DIR}/../compat/include")
if(DEFINED ENV{KC_NDK} AND NOT "$ENV{KC_NDK}" STREQUAL "")
  set(KC_CFLAGS "${KC_CFLAGS} -idirafter $ENV{KC_NDK}")
endif()
if(KC_SPECS)
  set(KC_FLAGS "${KC_FLAGS} -specs=${KC_SPECS}")
endif()
set(CMAKE_C_FLAGS_INIT   "${KC_FLAGS} ${KC_CFLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${KC_FLAGS} ${KC_CFLAGS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${KC_FLAGS}")
set(CMAKE_FIND_ROOT_PATH "${TC}/m68k-amigaos" "$ENV{DEPS_PREFIX}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
